# Copy this file to `.env` and fill in real values for local development.
# Never commit the real `.env` — it's already covered by .gitignore.
#
# None of these are secrets themselves (the actual OpenWeatherMap key lives
# in Secret Manager, not here) — this is just non-sensitive config.

# GCP project that holds Secret Manager, BigQuery, etc.
# When deployed as a Cloud Function (2nd gen), the platform sets
# GOOGLE_CLOUD_PROJECT automatically, so this is mainly for local runs.
GCP_PROJECT_ID=your-gcp-project-id

# Secret Manager secret holding the OpenWeatherMap API key.
OPENWEATHER_SECRET_NAME=openweather-api-key
OPENWEATHER_SECRET_VERSION=latest

# BigQuery landing zone for weather data.
BQ_DATASET=raw_data
BQ_WEATHER_TABLE=import_weather

# Locations to query, in OpenWeatherMap "City,CountryCode" format,
# separated by semicolons. Edit freely.
WEATHER_LOCATIONS=Paris,FR;London,GB;New York,US;Berlin,DE

# --- SFTP CSV ingestion ---
# BigQuery destination (schema is auto-detected from the CSV header).
BQ_CSV_TABLE=import_csv_data
BQ_CONTROL_TABLE=_ingested_files

SFTP_HOST=your-sftp-host.example.com
SFTP_PORT=22
SFTP_USERNAME=your-sftp-username
SFTP_REMOTE_DIR=/

# Set exactly ONE of these two, matching how the SFTP account authenticates.
# Both name a Secret Manager secret — never put the actual password/key here.
SFTP_PASSWORD_SECRET_NAME=sftp-password
SFTP_PRIVATE_KEY_SECRET_NAME=
